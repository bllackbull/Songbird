{
  "name": "songbird-client",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bllackbull/songbird.git"
  },
  "bugs": {
    "url": "https://github.com/bllackbull/songbird/issues"
  },
  "homepage": "https://github.com/bllackbull/songbird#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage --run",
    "test:watch": "vitest",
    "test:unit": "vitest --project unit --run",
    "test:browser": "vitest --project browser --run",
    "test:browser:headful": "VITEST_HEADFUL=1 vitest --project browser --run",
    "test:ui": "vitest --ui",
    "test:bench": "vitest bench --run"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.41.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "minimatch": "10.2.5"
  }
}
