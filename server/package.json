{
  "name": "songbird-server",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bllackbull/songbird.git"
  },
  "bugs": {
    "url": "https://github.com/bllackbull/songbird/issues"
  },
  "homepage": "https://github.com/bllackbull/songbird#readme",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=. --watch-path=../.env index.js",
    "start": "node index.js",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:bench": "vitest bench --run",
    "db:delete": "/bin/bash -p ../scripts/run-data-command.sh node scripts/delete-db.js",
    "db:reset": "/bin/bash -p ../scripts/run-data-command.sh node scripts/reset-db.js",
    "db:backup": "/bin/bash -p ../scripts/run-data-command.sh node scripts/backup-db.js",
    "db:restore": "/bin/bash -p ../scripts/run-data-command.sh node scripts/restore-db.js",
    "db:vacuum": "/bin/bash -p ../scripts/run-data-command.sh node scripts/vacuum-db.js",
    "db:help": "/bin/bash -p ../scripts/run-data-command.sh node scripts/db-help.js",
    "db:migrate": "/bin/bash -p ../scripts/run-data-command.sh node scripts/migrate.js",
    "db:backfill": "/bin/bash -p ../scripts/run-data-command.sh node scripts/backfill-message-file-metadata.js",
    "db:chat:create": "/bin/bash -p ../scripts/run-data-command.sh node scripts/create-chat.js",
    "db:chat:add": "/bin/bash -p ../scripts/run-data-command.sh node scripts/add-chat-member.js",
    "db:chat:edit": "/bin/bash -p ../scripts/run-data-command.sh node scripts/edit-chat.js",
    "db:chat:verify": "/bin/bash -p ../scripts/run-data-command.sh node scripts/verify-chat.js",
    "db:chat:delete": "/bin/bash -p ../scripts/run-data-command.sh node scripts/delete-chat.js",
    "db:file:delete": "/bin/bash -p ../scripts/run-data-command.sh node scripts/delete-file.js",
    "db:user:edit": "/bin/bash -p ../scripts/run-data-command.sh node scripts/edit-user.js",
    "db:user:ban": "/bin/bash -p ../scripts/run-data-command.sh node scripts/ban-user.js",
    "db:user:verify": "/bin/bash -p ../scripts/run-data-command.sh node scripts/verify-user.js",
    "db:user:delete": "/bin/bash -p ../scripts/run-data-command.sh node scripts/delete-user.js",
    "db:user:create": "/bin/bash -p ../scripts/run-data-command.sh node scripts/create-user.js",
    "db:owner:check": "/bin/bash -p ../scripts/run-data-command.sh node scripts/check-owner.js",
    "db:user:generate": "/bin/bash -p ../scripts/run-data-command.sh node scripts/generate-user.js",
    "db:message:generate": "/bin/bash -p ../scripts/run-data-command.sh node scripts/generate-chat-message.js",
    "db:inspect": "/bin/bash -p ../scripts/run-data-command.sh node scripts/inspect-db.js all",
    "db:chat:inspect": "/bin/bash -p ../scripts/run-data-command.sh node scripts/inspect-db.js chat",
    "db:user:inspect": "/bin/bash -p ../scripts/run-data-command.sh node scripts/inspect-db.js user",
    "db:file:inspect": "/bin/bash -p ../scripts/run-data-command.sh node scripts/inspect-db.js file",
    "remote:configure": "node scripts/configure-remote-channel.js",
    "storage:cors": "node scripts/configure-bucket-cors.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.3.4",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "sql.js": "^1.14.2",
    "telegram": "^2.26.22",
    "undici": "^8.10.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "fast-check": "^4.9.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
