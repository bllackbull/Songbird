{
  "name": "songbird",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bllackbull/songbird.git"
  },
  "bugs": {
    "url": "https://github.com/bllackbull/songbird/issues"
  },
  "homepage": "https://github.com/bllackbull/songbird#readme",
  "scripts": {
    "dev": "concurrently \"npm --prefix client run dev\" \"npm --prefix server run dev\"",
    "test": "concurrently \"npm --prefix client run test\" \"npm --prefix server run test\"",
    "start": "concurrently \"npm --prefix client run start\" \"npm --prefix server run start\"",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "remote:configure": "npm --prefix server run remote:configure",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:browser": "vitest"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^10.0.3",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "jsdom": "^29.1.1",
    "npm": "^11.16.0",
    "semantic-release": "^25.0.5",
    "supertest": "^7.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "volta": {
    "node": "24.18.0",
    "npm": "11.18.0"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
